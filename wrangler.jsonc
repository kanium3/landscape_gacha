{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "landscape-gacha",
    "main": ".svelte-kit/cloudflare/_worker.js",
    "compatibility_flags": [
        "nodejs_als"
    ],
    "compatibility_date": "2026-05-08",
    "assets": {
        "directory": ".svelte-kit/cloudflare",
        "binding": "ASSETS"
    }
}