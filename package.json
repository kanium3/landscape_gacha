{
	"name": "landscape-gacha",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"generate:data": "pnpm exec tsx scripts/generate-landscape-data.ts",
		"refresh:data": "pnpm run generate:data && pnpm run export:parquet",
		"export:parquet": "pnpm exec tsx scripts/export-parquet.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome check .",
		"format": "biome format . --write"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@duckdb/node-api": "1.5.2-r.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^22",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tsx": "^4.18.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"wrangler": "^4.90.0"
	},
	"dependencies": {
		"@duckdb/duckdb-wasm": "1.33.1-dev45.0",
		"effect": "^3.21.2"
	},
	"packageManager": "pnpm@10.33.0"
}
